# 复制为 backend/.env；使用 uvicorn --env-file .env 显式加载
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=jackfei
ADMIN_PASSWORD=change-me-to-a-strong-password
CORS_ORIGINS=http://localhost:5173
# DATABASE_URL=sqlite:///./blog.db
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/blog?charset=utf8mb4
# 可选：站点共享的 SenseNova Key；留空时使用者填写自己的 Key
SENSENOVA_API_KEY=
# 仅在 Linux 宿主机已配置独立 Docker 音源沙箱后启用
# MUSIC_SANDBOX=docker
# 完整歌曲缓存默认开启：5GB 配额，保留至少 8GB 系统空闲。
MUSIC_FILE_CACHE=1
# 仅在宿主机 Nginx 已配置 /_music_cache/ internal 目录后启用：
# MUSIC_CACHE_ACCEL=1

# 图片存储：默认 local 保留本地开发；正式 R2 使用独立公开图片桶
IMAGE_STORAGE=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# 例：R2_PUBLIC_BASE_URL=https://img.example.com；只放公开图片
